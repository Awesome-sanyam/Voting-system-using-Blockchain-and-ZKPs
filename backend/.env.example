# ============================================================
# BlockVote India — Environment Variables Template
# Copy this file to backend/.env and fill in your values.
# NEVER commit backend/.env to version control.
# ============================================================

# ── Django Security ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-hex-string

# Set to False in production
DJANGO_DEBUG=True

# ── Polygon Amoy Blockchain ──────────────────────────────────
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
SERVER_PRIVATE_KEY=0xYour64CharHexPrivateKeyHere
VOTING_CONTRACT_ADDRESS=0xYourDeployedVotingContractAddress

# ── Auditor Access Control ───────────────────────────────────
AUDITOR_TRUST_SECRET=ECI-AUDIT-2026-SECURE

# ── PostgreSQL (Optional — defaults to SQLite for local dev) ─
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=blockvote
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# ── Redis (Optional — defaults to InMemoryChannelLayer) ──────
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
